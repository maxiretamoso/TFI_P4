# Plantilla de variables de entorno — Sistema de Registro de Incidencias
# Para usarla: copiar este archivo como .env y completarlo
#     cp .env.example .env
# El .env con datos reales NUNCA se sube al repo (lo bloquea .gitignore)

# ---------- Conexión a la base (Supabase) ----------
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# ---------- Servidor ----------
PORT=3000

# ---------- Firma de los tokens JWT ----------
# Debe ser distinta de DB_PASSWORD y de al menos 32 caracteres.
# Para generar una al azar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- Emails (OPCIONAL) ----------
# Si quedan vacíos, el email se simula en consola y no rompe nada.
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Todas las pruebas de email llegan a esta casilla
MAIL_TO_TEST=

# ---------- Frontend (CORS) ----------
CLIENT_URL=http://localhost:5173
