# Copiar este archivo como .env y completarlo:  cp .env.example .env
# El .env real no se sube al repo (lo bloquea .gitignore)

# ---------- Base de datos (PostgreSQL local) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=incidencias_db

# false para PostgreSQL local, true solo si la base exige SSL
DB_SSL=false

# ---------- Servidor ----------
PORT=3000

# ---------- Tokens JWT ----------
# Mínimo 32 caracteres y distinta de DB_PASSWORD. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- Correo ----------
# Si quedan vacíos, el mail se imprime en la consola del servidor
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Si se completa, todos los mails van a esta casilla (para probar)
MAIL_TO_TEST=

# ---------- CORS ----------
# Orígenes del frontend, separados por coma. Tiene que coincidir con el puerto
# de Vite (ver client/package.json). Si queda vacío se permite cualquier origen.
CLIENT_URL=http://localhost:5174,http://127.0.0.1:5174
