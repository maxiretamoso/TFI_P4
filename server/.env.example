# Copiar este archivo como .env y completar con valores reales
# cp server/.env.example server/.env  (desde la raíz del repo)
# cp .env.example .env                (desde server/)

# Base de datos PostgreSQL (Supabase, ver README.md)
DB_HOST=db.tu-proyecto.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_de_supabase
DB_NAME=postgres

# Servidor
PORT=3000
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro

# Email (nodemailer) - usado al finalizar/cancelar incidencias.
# Si quedan vacías, el email se simula en consola y no rompe nada.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_email@gmail.com
MAIL_PASS=tu_app_password_de_gmail
MAIL_FROM=no-reply@incidencias.local
# Para pruebas sin enviar a usuarios reales, dejar vacío o poner un email de test
MAIL_TO_TEST=
