# Copiar este archivo como .env y completarlo:

# BD (PostgreSQL local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=incidencias_db
DB_SSL=false # false para PostgreSQL local, true solo si la base exige SSL

# Servidor
PORT=3000

# Tokens JWT
JWT_SECRET= # Para generarla: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Correo
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO_TEST=

# CORS
# Orígenes del frontend, separados por coma. Tiene que coincidir con el puerto de Vite (client/package.json). 
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173 # Si queda vacío se permite cualquier origen.